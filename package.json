{
  "name": "rocksprings-michealburford-com",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.5.2",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "check": "tsc --noEmit",
    "typecheck": "npm run check",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "content:audit": "node scripts/audit-rsc-source.mjs --check",
    "content:audit:source": "node scripts/audit-rsc-source.mjs --write",
    "content:build": "node scripts/sync-part-one-chapters.mjs --write",
    "content:sync": "npm run content:build",
    "content:check": "node scripts/sync-part-one-chapters.mjs --check",
    "content:check:source": "node scripts/sync-part-one-chapters.mjs --check-source",
    "public:check": "node scripts/check-phase-2-integrity.mjs",
    "phase2:check": "npm run public:check",
    "scene:generate": "node scripts/generate-town-scene.mjs",
    "scene:check": "node scripts/validate-scene.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
